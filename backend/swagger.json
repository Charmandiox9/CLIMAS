    "schemas": {
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "example": "John"
          },
          "lastName": {
            "type": "string",
            "example": "Doe"
          },
          "rut": {
            "type": "string",
            "example": "12345678-9"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "johndoe@climas.com"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "example": "MiSuperPassword123"
          },
          "phone": {
            "type": "string",
            "example": "+56912345678"
          },
          "roles": {
            "type": "string",
            "items": {
              "type": "string",
              "enum": [
                "ADMIN",
                "DOCTOR",
                "PATIENT"
              ]
            },
            "example": [
              "PATIENT"
            ],
            "enum": [
              "ADMIN",
              "DOCTOR",
